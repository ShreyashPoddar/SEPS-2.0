# --- TiDB (via Prisma) ---
# Get this from TiDB Cloud console -> your cluster -> Connect -> "Prisma" tab.
# Format: mysql://<user>:<password>@<host>:4000/<database>?sslaccept=strict
DATABASE_URL="mysql://USER.root:PASSWORD@HOST:4000/test?sslaccept=strict"

# --- Server ---
PORT=3050
NODE_ENV=development
CLIENT_URL=http://localhost:5176

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string

# --- Brevo SMTP (Email) ---
# Get these from: Brevo Dashboard -> Top-Right Profile -> "SMTP & API" -> "SMTP" tab.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-login-email@example.com
BREVO_SMTP_KEY=your-brevo-smtp-key-here
# Sender email MUST be a verified sender in Brevo (Senders, Domains & Dedicated IPs)
SENDER_EMAIL=sepsadmin@gmail.com
SENDER_NAME="SEPS Admin"
PROJECT_NAME="SEPS SRM"

