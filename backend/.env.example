# --- TiDB (via Prisma) ---
# Get this from TiDB Cloud console -> your cluster -> Connect -> "Prisma" tab.
# Format: mysql://<user>:<password>@<host>:4000/<database>?sslaccept=strict
DATABASE_URL="mysql://USER.root:PASSWORD@HOST:4000/test?sslaccept=strict"

# --- Server ---
PORT=3050
NODE_ENV=development
CLIENT_URL=http://localhost:5176

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string

# --- SendGrid (email) ---
# Signup/welcome emails are currently disabled in code, but forgotPassword
# still sends a reset email, so this needs to be real to use that flow.
SENDGRID_API_KEY=
SENDER_EMAIL=
PROJECT_NAME=Project Connect SRM
