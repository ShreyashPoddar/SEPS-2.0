generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String              @id @default(cuid())
  fullName               String
  email                  String?             @unique
  regNo                  String?             @unique
  password               String?
  role                   Role
  department             String              @default("Dept of ECE")
  internshipStatus       CohortTrack         @default(regular)
  internshipCompany      String              @default("")
  internshipDuration     String              @default("")
  internships            Json
  linkedinUrl            String              @default("")
  githubUrl              String              @default("")
  skills                 Json
  cgpa                   Float?
  resumeUrl              String              @default("")
  profilePic             String              @default("")
  experience             String?
  description            String?             @db.Text
  researchPast           String?             @db.Text
  isVerified             Boolean             @default(true)
  isProfileComplete      Boolean             @default(false)
  verificationToken      String?
  tokenExpires           DateTime?
  resetPasswordToken     String?
  resetPasswordExpires   DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  applicationMemberships ApplicationMember[]
  notifications          Notification[]
  projects               Project[]
  teamMemberships        TeamMember[]
  tickets                Ticket[]
  ticketsAsProjectIncharge Ticket[]            @relation("TicketProjectIncharge")
  ticketsAsFacultyAdvisor  Ticket[]            @relation("TicketFacultyAdvisor")
  ticketsAsHOD             Ticket[]            @relation("TicketHOD")

  // ── RDBMS Academic Allocations ─────────────────────────────────────────────
  sectionId              String?
  sectionName            String?
  section                Section?            @relation("SectionStudents", fields: [sectionId], references: [id], onDelete: SetNull)
  facultyAdvisorId       String?
  facultyAdvisor         User?               @relation("StudentFacultyAdvisor", fields: [facultyAdvisorId], references: [id], onDelete: SetNull)
  advisedStudents        User[]              @relation("StudentFacultyAdvisor")
  advisedSections        Section[]           @relation("SectionFacultyAdvisor")
  departmentId           String?
  departmentRel          Department?         @relation("StudentDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  facultyDepartmentId    String?
  facultyDepartment      Department?         @relation("FacultyDepartment", fields: [facultyDepartmentId], references: [id], onDelete: SetNull)
  headedDepartments      Department[]        @relation("DepartmentHOD")

  @@index([sectionId])
  @@index([facultyAdvisorId])
  @@index([departmentId])
  @@index([facultyDepartmentId])
}

model Project {
  id            String                @id @default(cuid())
  teacherId     String
  facultyName   String
  projectTitle  String
  description   String                @db.Text
  stream        String
  domain        String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  teacher       User                  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  applications  StudentProjectApply[]
  approvedTeams TeamApproved[]

  @@index([teacherId])
}

model StudentProjectApply {
  id              String              @id @default(cuid())
  projectId       String
  applicationType ApplicationType
  cohortTrack     CohortTrack         @default(regular)
  hasCrossBranch  Boolean             @default(false)
  status          ApplicationStatus   @default(pending_faculty_approval)
  priority        Int
  appliedAt       DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  members         ApplicationMember[]
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets         Ticket[]

  @@index([projectId])
}

model ApplicationMember {
  id                String              @id @default(cuid())
  applicationId     String
  studentId         String
  name              String
  regNo             String
  department        String              @default("Dept of ECE")
  internshipStatus  CohortTrack         @default(regular)
  status            MemberStatus        @default(pending)
  verificationToken String?
  createdAt         DateTime            @default(now())
  application       StudentProjectApply @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  student           User                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([studentId])
}

model TeamApproved {
  id              String          @id @default(cuid())
  projectId       String
  applicationType ApplicationType
  approvedAt      DateTime        @default(now())
  facultyName     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members         TeamMember[]
  tickets         Ticket[]

  @@index([projectId])
}

model TeamMember {
  id        String       @id @default(cuid())
  teamId    String
  studentId String
  name      String
  regNo     String
  createdAt DateTime     @default(now())
  student   User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  team      TeamApproved @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([studentId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String           @db.Text
  type      NotificationType @default(info)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GlobalDeadline {
  id       String   @id @default(cuid())
  deadline DateTime
}

model Ticket {
  id                 String               @id @default(cuid())
  ticketId           String               @unique
  applicationId      String?
  studentId          String
  projectTitle       String               @default("")
  facultyName        String               @default("")
  targetMember       Json
  changeType         TicketChangeType
  requestedChanges   Json?
  reason             String               @db.Text
  status             TicketStatus         @default(pending)
  progressStep       Int                  @default(1)
  coordinatorRemarks String               @default("")
  timeline           Json
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  teamId             String?
  hasInternship           Boolean              @default(false)
  requiresHodApproval     Boolean              @default(false)
  projectInchargeId       String?
  projectInchargeApproval String               @default("pending")
  facultyAdvisorId        String?
  facultyAdvisorApproval  String               @default("pending")
  hodId                   String?
  hodApproval             String               @default("not_required")

  application        StudentProjectApply? @relation(fields: [applicationId], references: [id])
  student            User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  team               TeamApproved?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  projectIncharge    User?                @relation("TicketProjectIncharge", fields: [projectInchargeId], references: [id], onDelete: SetNull)
  facultyAdvisor     User?                @relation("TicketFacultyAdvisor", fields: [facultyAdvisorId], references: [id], onDelete: SetNull)
  hod                User?                @relation("TicketHOD", fields: [hodId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([teamId])
  @@index([studentId])
  @@index([projectInchargeId])
  @@index([facultyAdvisorId])
  @@index([hodId])
}

model Department {
  id        String    @id @default(cuid())
  name      String    @unique
  code      String    @default("ECE")
  hodId     String?
  hod       User?     @relation("DepartmentHOD", fields: [hodId], references: [id], onDelete: SetNull)
  sections  Section[]
  students  User[]    @relation("StudentDepartment")
  faculty   User[]    @relation("FacultyDepartment")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([hodId])
}

model Section {
  id               String      @id @default(cuid())
  name             String
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  facultyAdvisorId String?
  facultyAdvisor   User?       @relation("SectionFacultyAdvisor", fields: [facultyAdvisorId], references: [id], onDelete: SetNull)
  students         User[]      @relation("SectionStudents")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([name, departmentId])
  @@index([departmentId])
  @@index([facultyAdvisorId])
}

enum Role {
  teacher
  student
}

enum ApplicationType {
  individual
  group
}

enum ApplicationStatus {
  pending_member_approval
  pending_faculty_approval
  approved
  rejected
}

enum MemberStatus {
  pending
  approved
}

enum NotificationType {
  info
  warning
  success
  error
}

enum CohortTrack {
  regular
  internship
}

enum TicketChangeType {
  name_correction
  replacement
  withdrawal
  cancellation
}

enum TicketStatus {
  pending
  in_review
  approved
  rejected
}
