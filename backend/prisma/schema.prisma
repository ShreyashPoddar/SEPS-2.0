// Prisma schema for TiDB (MySQL wire-protocol compatible).
// Replaces the old Mongoose/MongoDB models. Embedded arrays from Mongo
// (StudentProjectApply.members, TeamApproved.members) are normalized into
// their own join tables since TiDB is relational, not document-based.
// Ticket's small embedded objects (targetMember, requestedChanges, timeline)
// are kept as Json columns since they're not queried relationally anywhere.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  teacher
  student
}

enum ApplicationType {
  individual
  group
}

enum ApplicationStatus {
  pending_member_approval
  pending_faculty_approval
  approved
  rejected
}

enum MemberStatus {
  pending
  approved
}

enum NotificationType {
  info
  warning
  success
  error
}

enum CohortTrack {
  regular
  internship
}

enum TicketChangeType {
  name_correction
  replacement
  withdrawal
}

enum TicketStatus {
  pending
  in_review
  approved
  rejected
}

model User {
  id                    String    @id @default(cuid())
  fullName              String
  email                 String    @unique
  regNo                 String?   @unique
  password              String
  role                  Role
  department            String    @default("Dept of ECE")
  internshipStatus      CohortTrack @default(regular)
  internshipCompany     String    @default("")
  internshipDuration    String    @default("")
  internships           Json      @default("[]")
  linkedinUrl           String    @default("")
  githubUrl             String    @default("")
  skills                Json      @default("[]")
  cgpa                  Float?
  resumeUrl             String    @default("")
  profilePic            String    @default("")
  experience            String?
  description           String?   @db.Text
  researchPast          String?   @db.Text
  isVerified            Boolean   @default(true)
  verificationToken     String?
  tokenExpires          DateTime?
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  projects              Project[]
  applicationMemberships ApplicationMember[]
  teamMemberships       TeamMember[]
  notifications         Notification[]
  tickets               Ticket[]
}

model Project {
  id             String   @id @default(cuid())
  teacherId      String
  teacher        User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  facultyName    String
  projectTitle   String
  description    String   @db.Text
  stream         String
  domain         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  applications   StudentProjectApply[]
  approvedTeams  TeamApproved[]

  @@index([teacherId])
}

model StudentProjectApply {
  id              String            @id @default(cuid())
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  applicationType ApplicationType
  cohortTrack     CohortTrack       @default(regular)
  hasCrossBranch  Boolean           @default(false)
  status          ApplicationStatus @default(pending_faculty_approval)
  priority        Int
  appliedAt       DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  members         ApplicationMember[]
  tickets         Ticket[]

  @@index([projectId])
}

model ApplicationMember {
  id                String               @id @default(cuid())
  applicationId     String
  application       StudentProjectApply  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  studentId         String
  student           User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name              String
  regNo             String
  department        String               @default("Dept of ECE")
  internshipStatus  CohortTrack          @default(regular)
  status            MemberStatus         @default(pending)
  verificationToken String?
  createdAt         DateTime             @default(now())

  @@index([applicationId])
  @@index([studentId])
}

model TeamApproved {
  id              String          @id @default(cuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  applicationType ApplicationType
  approvedAt      DateTime        @default(now())
  facultyName     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  members         TeamMember[]

  @@index([projectId])
}

model TeamMember {
  id        String       @id @default(cuid())
  teamId    String
  team      TeamApproved @relation(fields: [teamId], references: [id], onDelete: Cascade)
  studentId String
  student   User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name      String
  regNo     String
  createdAt DateTime     @default(now())

  @@index([teamId])
  @@index([studentId])
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String            @db.Text
  type      NotificationType  @default(info)
  isRead    Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId])
}

model GlobalDeadline {
  id       String   @id @default(cuid())
  deadline DateTime
}

model Ticket {
  id                 String              @id @default(cuid())
  ticketId           String              @unique
  applicationId      String
  application        StudentProjectApply @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  studentId          String
  student             User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  projectTitle       String              @default("")
  facultyName        String              @default("")
  // { studentId, name, regNo, department }
  targetMember       Json
  changeType         TicketChangeType
  // { correctedName?, correctedRegNo?, replacementStudent? }
  requestedChanges   Json?
  reason             String              @db.Text
  status             TicketStatus        @default(pending)
  progressStep       Int                 @default(1)
  coordinatorRemarks String              @default("")
  // [{ step, date, message }]
  timeline           Json                @default("[]")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([applicationId])
  @@index([studentId])
}
